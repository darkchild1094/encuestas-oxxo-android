# Copia este archivo a app/keystore.properties y rellena los valores
# reales. app/keystore.properties NO se versiona (.gitignore).
#
# 1. Genera la UPLOAD KEY (una sola vez, guardala en lugar seguro):
#
#    keytool -genkeypair -v -keystore upload-keystore.jks \
#      -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
#    Deja el .jks fuera del repo (p. ej. en app/ pero gitignoreado, o
#    mejor en una carpeta aparte y pon la ruta absoluta abajo).
#
# 2. En Play Console activa "Play App Signing" (por defecto). Subes el
#    .aab firmado con ESTA upload key; Google lo re-firma con la app
#    signing key para distribuir. El APK de auto-actualizacion que
#    sirves desde tu servidor debe firmarse con la MISMA upload key
#    siempre (si cambia, "app no instalada" al actualizar).

storeFile=app/upload-keystore.jks
storePassword=CAMBIA_ESTO
keyAlias=upload
keyPassword=CAMBIA_ESTO
