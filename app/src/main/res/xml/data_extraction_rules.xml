<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de backup para Android 12+ (cloud backup y device-to-device).

    Se EXCLUYE la base de datos Room (encuestas_oxxo.db y sus archivos
    WAL/SHM). Contiene la cola de encuestas pendientes de sincronizar:
    si Google restaura una copia vieja sobre una instalacion limpia,
    reaparecen encuestas fantasma ya subidas (o a medio subir) y el
    contador de pendientes queda descuadrado. La cola vive solo en el
    dispositivo donde se capturo; el servidor es la fuente de verdad.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="encuestas_oxxo.db" />
        <exclude domain="database" path="encuestas_oxxo.db-wal" />
        <exclude domain="database" path="encuestas_oxxo.db-shm" />
        <exclude domain="database" path="encuestas_oxxo.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="encuestas_oxxo.db" />
        <exclude domain="database" path="encuestas_oxxo.db-wal" />
        <exclude domain="database" path="encuestas_oxxo.db-shm" />
        <exclude domain="database" path="encuestas_oxxo.db-journal" />
    </device-transfer>
</data-extraction-rules>
