<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de backup para Android 11 y anteriores (Auto Backup).
    Mismo criterio que data_extraction_rules.xml: se excluye la base de
    datos Room para que un restore no reviva la cola local de encuestas
    pendientes sobre una instalacion limpia.
-->
<full-backup-content>
    <exclude domain="database" path="encuestas_oxxo.db" />
    <exclude domain="database" path="encuestas_oxxo.db-wal" />
    <exclude domain="database" path="encuestas_oxxo.db-shm" />
    <exclude domain="database" path="encuestas_oxxo.db-journal" />
</full-backup-content>
